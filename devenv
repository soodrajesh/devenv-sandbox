#!/usr/bin/env bash
set -euo pipefail

SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "${SCRIPT_SOURCE}" ]]; do
    SCRIPT_DIR="$(cd "$(dirname "${SCRIPT_SOURCE}")" && pwd)"
    SCRIPT_SOURCE="$(readlink "${SCRIPT_SOURCE}")"
    [[ "${SCRIPT_SOURCE}" != /* ]] && SCRIPT_SOURCE="${SCRIPT_DIR}/${SCRIPT_SOURCE}"
done
DEVENV_DIR="$(cd "$(dirname "${SCRIPT_SOURCE}")" && pwd)"

if ! command -v jq >/dev/null 2>&1; then
    echo "error: jq is required on the host (used to sanitize ~/.claude/settings.json before mounting). Install it and retry." >&2
    exit 1
fi

IMAGE_NAME="devenv-sandbox"
IMAGE_TAG="latest"
HASH_FILE="${DEVENV_DIR}/.last-build-hash"
DOCKERFILE="${DEVENV_DIR}/Dockerfile"
WORKSPACE_DIR="${DEVENV_WORKSPACE:-$(pwd)}"

current_hash() {
    shasum -a 256 "${DOCKERFILE}" | awk '{print $1}'
}

image_exists() {
    docker image inspect "${IMAGE_NAME}:${IMAGE_TAG}" >/dev/null 2>&1
}

needs_build() {
    if ! image_exists; then
        return 0
    fi
    if [[ ! -f "${HASH_FILE}" ]]; then
        return 0
    fi
    [[ "$(cat "${HASH_FILE}")" != "$(current_hash)" ]]
}

do_build() {
    echo "devenv: building ${IMAGE_NAME}:${IMAGE_TAG} ..."
    docker build -t "${IMAGE_NAME}:${IMAGE_TAG}" -f "${DOCKERFILE}" "${DEVENV_DIR}"
    current_hash > "${HASH_FILE}"
    echo "devenv: build complete"
}

warn_env_files() {
    local found
    found=$(find "${WORKSPACE_DIR}" -maxdepth 3 -type f \( -name '.env' -o -name '.env.*' -o -name '*.env' \) \
        -not -path '*/node_modules/*' -not -path '*/.git/*' 2>/dev/null)
    if [[ -n "${found}" ]]; then
        echo "devenv: WARNING — env/secret-looking file(s) under ${WORKSPACE_DIR} will be exposed read-write to a container with host Docker access:" >&2
        echo "${found}" | sed 's/^/devenv:   /' >&2
    fi
}

# Host ~/.claude/settings.json may carry host-specific hooks (e.g. a PreToolUse
# Bash gate) or skipDangerousModePermissionPrompt. Neither survives meaningfully
# inside the container (the hook's binary is typically host-only) and mounting
# them in verbatim would silently change or weaken the sandbox's own permission
# behavior. Strip those keys from the copy we mount, leave the host file untouched.
sanitize_settings() {
    local src="$1" dest="$2"
    jq 'del(.hooks, .skipDangerousModePermissionPrompt)' "${src}" > "${dest}"
}

do_run() {
    echo "devenv: starting container (workspace: ${WORKSPACE_DIR})"
    warn_env_files

    # Bind-mounting onto a path that doesn't exist yet creates that path on the
    # HOST side (Docker Desktop creates it owned by the invoking user). It survives
    # after the container exits since --rm only removes the container, not host
    # mount-point paths Docker created for it. We track what we created here and
    # remove it after the container exits (only if still empty — see cleanup below).
    local extra_mounts=()
    local created_claude_dir=0
    local created_claude_md=0

    if [[ ! -e "${WORKSPACE_DIR}/.claude" ]]; then
        extra_mounts+=(-v "${DEVENV_DIR}/claude-defaults/.claude:/workspace/.claude:ro")
        created_claude_dir=1
    fi
    if [[ ! -f "${WORKSPACE_DIR}/CLAUDE.md" ]]; then
        extra_mounts+=(-v "${DEVENV_DIR}/claude-defaults/CLAUDE.md:/workspace/CLAUDE.md:ro")
        created_claude_md=1
    fi

    # Mount only what's needed to authenticate `claude` inside the container —
    # NOT the whole ~/.claude dir, which also holds mcp.json (may contain plaintext
    # API tokens for MCP servers), conversation history, session state, etc.
    # .credentials.json is mounted read-write since Claude Code may refresh the OAuth token.
    local claude_auth_mounts=()
    local sanitized_settings=""
    for f in .credentials.json settings.json CLAUDE.md; do
        [[ -f "${HOME}/.claude/${f}" ]] || continue
        if [[ "${f}" == "settings.json" ]]; then
            sanitized_settings="$(mktemp)"
            sanitize_settings "${HOME}/.claude/${f}" "${sanitized_settings}"
            claude_auth_mounts+=(-v "${sanitized_settings}:/root/.claude/${f}")
        else
            claude_auth_mounts+=(-v "${HOME}/.claude/${f}:/root/.claude/${f}")
        fi
    done

    docker run -it --rm \
        -v /var/run/docker.sock:/var/run/docker.sock \
        -v "${WORKSPACE_DIR}:/workspace" \
        "${claude_auth_mounts[@]}" \
        "${extra_mounts[@]}" \
        "${IMAGE_NAME}:${IMAGE_TAG}"

    [[ -n "${sanitized_settings}" ]] && rm -f "${sanitized_settings}"

    # Clean up stub mount points we created above, but only if still empty —
    # never remove something you actually wrote to during the session.
    if [[ "${created_claude_dir}" == "1" ]] && [[ -d "${WORKSPACE_DIR}/.claude" ]]; then
        if [[ -z "$(ls -A "${WORKSPACE_DIR}/.claude" 2>/dev/null)" ]]; then
            rmdir "${WORKSPACE_DIR}/.claude" 2>/dev/null || true
        fi
    fi
    if [[ "${created_claude_md}" == "1" ]] && [[ -f "${WORKSPACE_DIR}/CLAUDE.md" ]]; then
        if [[ ! -s "${WORKSPACE_DIR}/CLAUDE.md" ]]; then
            rm -f "${WORKSPACE_DIR}/CLAUDE.md" 2>/dev/null || true
        fi
    fi
}

do_clean() {
    echo "devenv: pruning dangling image layers ..."
    docker image prune -f
    echo "devenv: clean complete"
}

cmd="${1:-up}"

case "${cmd}" in
    up)
        if needs_build; then
            do_build
        fi
        do_run
        ;;
    build)
        do_build
        ;;
    shell)
        if needs_build; then
            do_build
        fi
        do_run
        ;;
    clean)
        do_clean
        ;;
    *)
        echo "usage: devenv [up|build|shell|clean]" >&2
        echo "  up     build if stale, then start a shell (default)" >&2
        echo "  build  force a rebuild" >&2
        echo "  shell  alias for up" >&2
        echo "  clean  prune dangling image layers left behind by rebuilds" >&2
        echo "" >&2
        echo "env: DEVENV_WORKSPACE=<dir>  mount <dir> at /workspace instead of the current directory" >&2
        exit 1
        ;;
esac
